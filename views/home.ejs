<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Files · DriveX</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  </head>
  <body
    class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-white"
  >
    <main class="min-h-screen">
      <!-- Header -->
      <header
        class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950"
      >
        <div
          class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
        >
          <!-- Brand -->
          <a href="/home" class="flex items-center">
            <img src="/logo.png" alt="DriveX" class="h-10 w-auto" />
            <span class="text-lg font-semibold tracking-tight"> DriveX </span>
          </a>
          <!-- Logout -->
          <a
            href="/user/logout"
            class="rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600 dark:border-gray-800 dark:text-gray-400 dark:hover:border-red-900/50 dark:hover:bg-red-950/30 dark:hover:text-red-400"
          >
            Logout
          </a>
        </div>
      </header>
      <!-- Content -->
      <div class="mx-auto max-w-6xl px-6 py-8">
        <!-- Page heading -->
        <div
          class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h1 class="text-2xl font-semibold tracking-tight">Your Files</h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Store and manage your files in one place.
            </p>
          </div>

          <!-- Upload -->
          <button
            type="button"
            onclick="showPopup()"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-5"
              aria-hidden="true"
            >
              <path d="M11 11V5H13V11H19V13H13V19H11V13H5V11H11Z" />
            </svg>
            Upload file
          </button>
        </div>

        <!-- Files -->
        <section class="mt-8">
          <% if (!files || files.length === 0) { %>
          <!-- Empty state -->
          <div
            class="rounded-xl border border-dashed border-gray-200 px-6 py-16 text-center dark:border-gray-800"
          >
            <div
              class="mx-auto flex size-12 items-center justify-center rounded-full bg-gray-100 text-gray-500 dark:bg-gray-900 dark:text-gray-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-6"
                aria-hidden="true"
              >
                <path
                  d="M19 20H5C3.89543 20 3 19.1046 3 18V6C3 4.89543 3.89543 4 5 4H10L12 6H19C20.1046 6 21 6.89543 21 8V18C21 19.1046 20.1046 20 19 20ZM5 8V18H19V8H5Z"
                />
              </svg>
            </div>
            <h2 class="mt-4 text-sm font-medium">No files yet</h2>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
              Upload your first file to get started.
            </p>
            <button
              type="button"
              onclick="showPopup()"
              class="mt-5 text-sm font-medium text-blue-600 hover:text-blue-500 dark:text-blue-400"
            >
              Upload a file
            </button>
          </div>
          <% } else { %>
          <!-- File list -->
          <div
            class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800"
          >
            <!-- List header -->
            <div
              class="hidden grid-cols-4 items-center gap-4 border-b border-gray-200 bg-gray-50 px-5 py-3 text-xs font-medium uppercase tracking-wide text-gray-400 dark:border-gray-800 dark:bg-gray-900/50 dark:text-gray-500 sm:grid"
            >
              <span>Name</span>
              <span>Date</span>
              <span>Size</span>
              <span class="text-right">Actions</span>
            </div>

            <% files.forEach(file => { %>
            <div
              class="group flex flex-col gap-3 border-b border-gray-100 px-5 py-4 last:border-b-0 hover:bg-gray-50 sm:grid sm:grid-cols-4 sm:items-center sm:gap-4 dark:border-gray-800 dark:hover:bg-gray-900/50"
            >
              <!-- File name -->
              <div class="min-w-0">
                <a
                  href="/file/<%= file._id %>"
                  class="block truncate text-sm font-medium text-gray-900 transition hover:text-blue-600 dark:text-white dark:hover:text-blue-400"
                  title="<%= file.originalname %>"
                >
                  <%= file.originalname %>
                </a>

                <p
                  class="mt-0.5 text-xs text-gray-400 sm:hidden dark:text-gray-500"
                >
                  <%= file.size %>
                  KB
                </p>
              </div>

              <!-- Date -->
              <div
                class="hidden text-sm text-gray-500 sm:block dark:text-gray-400"
              >
                <%= new Date(file.createdAt).toLocaleDateString("en-US", { day:
                "numeric", month: "short", year: "numeric" }) %>
              </div>

              <!-- Size -->
              <div
                class="hidden text-sm text-gray-500 sm:block dark:text-gray-400"
              >
                <%= file.size %>
                KB
              </div>

              <!-- Actions -->
              <div
                class="flex items-center justify-end gap-1 border-t border-gray-100 pt-3 sm:border-0 sm:pt-0 dark:border-gray-800"
              >
                <!-- View -->
                <a
                  href="/file/<%= file._id %>"
                  aria-label="View <%= file.originalname %>"
                  class="rounded-lg p-2 text-gray-400 transition hover:bg-blue-50 hover:text-blue-600 dark:hover:bg-blue-950/30 dark:hover:text-blue-400"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-5"
                    aria-hidden="true"
                  >
                    <path
                      d="M12 4.5C7 4.5 2.73 7.61 1 12C2.73 16.39 7 19.5 12 19.5C17 19.5 21.27 16.39 23 12C21.27 7.61 17 4.5 12 4.5ZM12 17.5C8.96 17.5 6.5 15.04 6.5 12C6.5 8.96 8.96 6.5 12 6.5C15.04 6.5 17.5 8.96 17.5 12C17.5 15.04 15.04 17.5 12 17.5ZM12 8.5C10.07 8.5 8.5 10.07 8.5 12C8.5 13.93 10.07 15.5 12 15.5C13.93 15.5 15.5 13.93 15.5 12C15.5 10.07 13.93 8.5 12 8.5Z"
                    />
                  </svg>
                </a>

                <!-- Download -->
                <a
                  href="/download/<%= file.path %>"
                  download="<%= file.originalname %>"
                  aria-label="Download <%= file.originalname %>"
                  class="rounded-lg p-2 text-gray-400 transition hover:bg-green-50 hover:text-green-600 dark:hover:bg-green-950/30 dark:hover:text-green-400"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="size-5"
                    aria-hidden="true"
                  >
                    <path
                      d="M13 4H11V13.17L8.41 10.59L7 12L12 17L17 12L15.59 10.59L13 13.17V4ZM5 20H19V18H5V20Z"
                    />
                  </svg>
                </a>

                <!-- Delete -->
                <form
                  action="/file/<%= file._id %>"
                  method="POST"
                  onsubmit="return deleteFile(event, '<%= file._id %>');"
                >
                  <button
                    type="submit"
                    aria-label="Delete <%= file.originalname %>"
                    class="rounded-lg p-2 text-gray-400 transition hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/30 dark:hover:text-red-400 cursor-pointer"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="size-5"
                      aria-hidden="true"
                    >
                      <path
                        d="M7 4V2H17V4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7ZM6 6V20H18V6H6ZM9 9H11V17H9V9ZM13 9H15V17H13V9Z"
                      />
                    </svg>
                  </button>
                </form>
              </div>
            </div>

            <% }) %>
          </div>

          <% } %>
        </section>
      </div>
    </main>

    <!-- Upload Modal -->
    <div
      id="upload-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 px-6 backdrop-blur-sm"
      onclick="handleModalBackground(event)"
    >
      <div
        class="relative w-full max-w-md rounded-xl border border-gray-200 bg-white p-6 shadow-xl dark:border-gray-800 dark:bg-gray-950"
        role="dialog"
        aria-modal="true"
        aria-labelledby="upload-title"
      >
        <!-- Close -->
        <button
          type="button"
          onclick="hidePopup()"
          aria-label="Close upload dialog"
          class="absolute right-4 top-4 rounded-lg p-2 text-gray-400 transition hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-900 dark:hover:text-gray-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-5"
          >
            <path
              d="M18.3 5.71L12 12L5.7 5.71L4.29 7.12L10.59 13.41L4.29 19.71L5.7 21.12L12 14.83L18.3 21.12L19.71 19.71L13.41 13.41L19.71 7.12L18.3 5.71Z"
            />
          </svg>
        </button>

        <div class="mb-6">
          <h2 id="upload-title" class="text-lg font-semibold tracking-tight">
            Upload a file
          </h2>

          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Select a file to add it to your DriveX storage.
          </p>
        </div>

        <form
          id="upload-form"
          action="/upload"
          method="POST"
          enctype="multipart/form-data"
        >
          <!-- Dropzone -->
          <label
            for="dropzone-file"
            class="flex min-h-48 cursor-pointer flex-col items-center justify-center rounded-xl border border-dashed border-gray-300 bg-gray-50 px-5 py-8 text-center transition hover:border-blue-400 hover:bg-blue-50/50 dark:border-gray-700 dark:bg-gray-900/50 dark:hover:border-blue-600 dark:hover:bg-blue-950/20"
          >
            <div
              class="flex size-12 items-center justify-center rounded-full bg-white text-blue-600 shadow-sm dark:bg-gray-800 dark:text-blue-400"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-6"
                aria-hidden="true"
              >
                <path d="M13 13V19H11V13H5V11H11V5H13V11H19V13H13Z" />
              </svg>
            </div>

            <p class="mt-4 text-sm text-gray-700 dark:text-gray-200">
              <span class="font-medium text-blue-600 dark:text-blue-400">
                Choose a file
              </span>
              or drag and drop
            </p>

            <p class="mt-2 text-xs text-gray-400 dark:text-gray-500">
              PNG, JPG, JPEG, PDF, DOCX · Maximum 1 MB
            </p>

            <input
              id="dropzone-file"
              type="file"
              name="file"
              accept=".png,.jpg,.jpeg,.pdf,.docx"
              class="hidden"
              required
            />
          </label>

          <!-- File Preview -->
          <div
            id="file-preview"
            class="mt-3 hidden rounded-lg bg-gray-50 px-4 py-3 text-sm dark:bg-gray-900"
          ></div>

          <!-- Actions -->
          <div class="mt-5 flex gap-3">
            <button
              type="button"
              onclick="hidePopup()"
              class="flex-1 rounded-lg border border-gray-200 px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-900 cursor-pointer"
            >
              Cancel
            </button>

            <button
              id="upload-button"
              type="submit"
              class="flex-1 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer"
            >
              Upload
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      const uploadModal = document.getElementById("upload-modal");
      const dropzoneInput = document.getElementById("dropzone-file");
      const preview = document.getElementById("file-preview");
      const uploadForm = document.getElementById("upload-form");
      const uploadButton = document.getElementById("upload-button");

      function showPopup() {
        uploadModal.classList.remove("hidden");
        uploadModal.classList.add("flex");
        document.body.classList.add("overflow-hidden");
      }

      function hidePopup() {
        uploadModal.classList.add("hidden");
        uploadModal.classList.remove("flex");
        document.body.classList.remove("overflow-hidden");
      }

      function handleModalBackground(event) {
        if (event.target === uploadModal) {
          hidePopup();
        }
      }

      function showDefaultPreview() {
        preview.classList.add("hidden");
        preview.innerHTML = "";
      }

      dropzoneInput.addEventListener("change", function () {
        const file = this.files[0];

        if (!file) {
          showDefaultPreview();
          return;
        }

        const sizeKB = Math.round(file.size / 1024);

        preview.classList.remove("hidden");
        preview.innerHTML = ` <div class="flex items-center justify-between gap-3"> <div class="min-w-0"> <p class="truncate font-medium text-gray-700 dark:text-gray-200"> ${file.name} </p> <p class="mt-0.5 text-xs text-gray-400 dark:text-gray-500"> ${sizeKB} KB </p> </div>

      <button type="button" onclick="clearSelectedFile()" class="shrink-0 text-xs font-medium text-red-500 hover:text-red-600" > Remove </button> </div> `;
      });

      function clearSelectedFile() {
        dropzoneInput.value = "";
        showDefaultPreview();
      }

      uploadForm.addEventListener("submit", function () {
        uploadButton.disabled = true;
        uploadButton.textContent = "Uploading...";
        uploadButton.classList.add("cursor-not-allowed", "opacity-70");
      });

      document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          hidePopup();
        }
      });

      async function deleteFile(event, fileId) {
        event.preventDefault();

        const confirmed = confirm("Are you sure you want to delete this file?");

        if (!confirmed) {
          return false;
        }

        try {
          const response = await fetch(`/file/${fileId}`, {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
          });

          const data = await response.json();

          if (response.ok && data.message === "File deleted successfully") {
            window.location.reload();
            return false;
          }

          alert(data.error || data.message || "Error deleting file.");
        } catch (error) {
          alert("Unable to delete the file. Please try again.");
        }

        return false;
      }
    </script>
  </body>
</html>
