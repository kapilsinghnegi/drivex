<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>DriveX</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  </head>

  <body
    class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-white"
  >
    <main class="flex min-h-screen items-center justify-center px-6">
      <div class="w-full max-w-md text-center">
        <!-- Logo -->
        <image
          src="/logo.png"
          class="mx-auto flex h-24 w-auto items-center justify-center"
        />

        <!-- Heading -->
        <h1 class="text-3xl font-semibold tracking-tight">DriveX</h1>

        <p class="mt-3 text-gray-500 dark:text-gray-400">
          Simple and secure file storage.
        </p>

        <!-- Actions -->
        <div class="mt-8 flex flex-col gap-3">
          <a
            href="/user/login"
            class="rounded-lg bg-blue-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-blue-700"
          >
            Login
          </a>

          <a
            href="/user/register"
            class="rounded-lg border border-gray-200 px-5 py-3 text-sm font-medium text-gray-700 transition hover:bg-gray-50 dark:border-gray-800 dark:text-gray-300 dark:hover:bg-gray-900"
          >
            Create an account
          </a>

          <a
            href="/home"
            class="mt-2 text-sm text-blue-600 hover:text-blue-500 dark:text-blue-400"
          >
            Go to Home
          </a>
        </div>

        <!-- Footer -->
        <p class="mt-10 text-xs text-gray-400">Your files, all in one place.</p>
      </div>
    </main>
  </body>
</html>
