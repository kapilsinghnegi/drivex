<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login · DriveX</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  </head>

  <body
    class="min-h-screen bg-white text-gray-900 dark:bg-gray-950 dark:text-white"
  >
    <main
      class="relative flex min-h-screen items-start justify-center px-6 py-12"
    >
      <!-- Back -->
      <a
        href="/"
        aria-label="Back to DriveX"
        class="absolute left-6 top-6 text-gray-400 transition hover:text-gray-600 dark:hover:text-gray-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-6"
        >
          <path
            d="M10.8284 12.0007L15.7782 16.9504L14.364 18.3646L8 12.0007L14.364 5.63672L15.7782 7.05093L10.8284 12.0007Z"
          />
        </svg>
      </a>

      <div class="w-full max-w-md">
        <!-- Logo & Header -->
        <div class="mb-8 text-center">
          <a href="/" class="inline-block">
            <img src="/logo.png" alt="DriveX" class="mx-auto h-20 w-auto" />
          </a>

          <h1 class="mt-5 text-3xl font-semibold tracking-tight">
            Welcome back
          </h1>

          <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
            Sign in to access your files.
          </p>
        </div>

        <!-- Error Message -->
        <% if (typeof error !== "undefined" && error) { %>
        <div
          class="mb-5 flex items-center gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-400"
          role="alert"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="size-5 shrink-0"
            aria-hidden="true"
          >
            <path
              d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM11 15H13V17H11V15ZM11 7H13V13H11V7Z"
            />
          </svg>

          <span><%= error %></span>
        </div>
        <% } %>

        <!-- Login Form -->
        <form action="/user/login" method="POST" class="space-y-5">
          <!-- Username -->
          <div>
            <label
              for="username"
              class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
            >
              Username
            </label>

            <input
              type="text"
              id="username"
              name="username"
              placeholder="John"
              autocomplete="username"
              value="<%= typeof username !== 'undefined' ? username : '' %>"
              required
              autofocus
              class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 dark:border-gray-800 dark:bg-gray-950 dark:text-white dark:placeholder:text-gray-600 dark:focus:border-blue-500"
            />
          </div>

          <!-- Password -->
          <div>
            <label
              for="password"
              class="mb-2 block text-sm font-medium text-gray-900 dark:text-white"
            >
              Password
            </label>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              autocomplete="current-password"
              required
              class="block w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 dark:border-gray-800 dark:bg-gray-950 dark:text-white dark:placeholder:text-gray-600 dark:focus:border-blue-500"
            />
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full rounded-lg bg-blue-600 px-5 py-3 text-sm font-medium text-white transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500/20"
          >
            Login
          </button>
        </form>

        <!-- Register -->
        <p class="mt-8 text-center text-sm text-gray-500 dark:text-gray-400">
          Don't have an account?
          <a
            href="/user/register"
            class="font-medium text-blue-600 transition hover:text-blue-500 dark:text-blue-400"
          >
            Create an account
          </a>
        </p>
      </div>
    </main>
  </body>
</html>
